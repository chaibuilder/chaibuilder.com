{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaibuilder-old",
  "main": ".open-next/worker.js",
  "account_id": "a8284f05d1f5378c380c5a7b3082dbd1",
  "compatibility_date": "2026-05-27",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets served by Cloudflare
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
  },

  // R2 bucket for incremental (ISR) cache
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "chaibuilder-old-cache-bucket",
    },
  ],

  // Durable Object for the revalidation queue
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
      },
    ],
  },

  // Required migration for the DO SQLite class
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"],
    },
  ],

  // D1 database for tag-based cache invalidation
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "chaibuilder-old-tag-cache",
      "database_id": "5bb02304-11f8-4473-8dee-15ba479f1ffb",
    },
  ],

  // Observability (optional but recommended)
  "observability": {
    "enabled": true,
  },
}
