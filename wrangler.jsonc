{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaibuilder-old",
  "main": "./worker/index.ts",
  "account_id": "a8284f05d1f5378c380c5a7b3082dbd1",
  "compatibility_date": "2026-05-27",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets served by Cloudflare
  "assets": {
    "binding": "ASSETS",
    "directory": "dist/client",
  },

  // vinext uses KV for incremental (ISR) cache
  "kv_namespaces": [
    {
      "binding": "VINEXT_CACHE",
      "id": "0be22850c7fd4ed3984ca020d03e38c7"
    }
  ],

  // D1 database for tag-based cache invalidation
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "chaibuilder-old-tag-cache",
      "database_id": "5bb02304-11f8-4473-8dee-15ba479f1ffb",
    },
  ],

  // Observability (optional but recommended)
  "observability": {
    "enabled": true,
  },

  // Delete obsolete OpenNext Durable Objects
  "migrations": [
    {
      "tag": "v3",
      "deleted_classes": ["DOQueueHandler"]
    }
  ]
}
